{
  "name": "gong-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Gong API - exposes call listings, transcripts, and metadata to Claude Desktop",
  "type": "module",
  "bin": {
    "gong-mcp-server": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
